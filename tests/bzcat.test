#!/bin/bash

[ -f testing.sh ] && . testing.sh

#testing "name" "command" "result" "infile" "stdin"
testcmd "2 known files" \
 '"$FILES/blkid/"{minix,ntfs}.bz2 | sha1sum | sed s/\ .\*//' \
 'c0b7469c9660d6056a988ef8a7fe73925efc9266\n' '' ''
testcmd "overflow" \
  '"$FILES/bzcat/overflow.bz2" >/dev/null 2>/dev/null || echo bad' 'bad\n' '' ''
testcmd "overflow2" \
  '"$FILES/bzcat/runcnt_overflow.bz2" >/dev/null 2>/dev/null || echo bad' \
  'bad\n' '' ''
testcmd "badcrc" \
  '"$FILES/bzcat/badcrc.bz2" > /dev/null 2>/dev/null || echo bad' 'bad\n' '' ''
